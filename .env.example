# wisereport.co.kr 계정
WISEREPORT_ID=your_id_here
WISEREPORT_PW=your_password_here

# OpenRouter API key (요약용)
# https://openrouter.ai/keys 에서 발급
OPENROUTER_API_KEY=sk-or-v1-...
# 사용할 모델 (기본: xiaomi/mimo-v2.5-pro - 비용 효율적, 한국어 품질 우수)
# 다른 옵션: anthropic/claude-opus-4.6 (가장 정밀, 비용 6-8배),
#          anthropic/claude-sonnet-4.5 (중간), xiaomi/mimo-v2-flash (또 10배 저렴)
OPENROUTER_MODEL=xiaomi/mimo-v2.5-pro
# 폴백 모델 (선택). 기본 모델이 빈 응답/timeout으로 2회 재시도 후 실패하면
# 마지막 시도(3차)에서 이 모델로 자동 교체. 다른 provider 권장 (예: anthropic).
# 비워두면 동일 모델로 3회 시도.
OPENROUTER_FALLBACK_MODEL=

# =========== CompanyBot (기업명+티커 → 종목 리포트 발송) ===========
# CLI(src.main) 발송 + bot_worker + orchestrator 모두에 사용
TELEGRAM_BOT_TOKEN=
TELEGRAM_USERNAME=@allymax
TELEGRAM_CHAT_ID=
ALLOWED_CHAT_IDS=

# =========== IndustryBot (산업 리포트, @AnselmsSlave3bot) ===========
# 자동: 월/수/금 09:00 KST → 산업 Top10 (1000자 요약 + PDF)
# 수동: 산업명 입력 → 인기 5건 + 최신 5건 (5000자 요약 + PDF)
INDUSTRY_BOT_TOKEN=
INDUSTRY_CHAT_ID=
INDUSTRY_ALLOWED_CHAT_IDS=

# =========== MarketBot (투자전략/시황, @AnselmsSlave4bot) ===========
# 자동: 매일 09:00 KST → 신규 시황 리포트 (1000자 요약 + PDF, 중복 제외)
MARKET_BOT_TOKEN=
MARKET_CHAT_ID=
MARKET_ALLOWED_CHAT_IDS=

# =========== GlobalBot (글로벌, 토큰 미정) ===========
# 자동: 매주 토 09:00 KST → 글로벌 Top10 (1000자 요약 + PDF)
GLOBAL_BOT_TOKEN=
GLOBAL_CHAT_ID=
GLOBAL_ALLOWED_CHAT_IDS=

# =========== IdeaBot (투자 아이디어 → 영업레버리지 Top 5 종목) ===========
# 사용자 텍스트 입력 → 웹검색(논리의 기울기 검증) + 산업 2-3개 + 후보 30종목
#   → wisereport 산업/종목 리포트 → 영업레버리지 Top 5 + PDF 발송 (15-25분)
# 스케줄 작업 없음 (사용자 명령 only).
IDEA_BOT_TOKEN=
IDEA_ALLOWED_CHAT_IDS=
# 모델 3-티어 — 비용 vs 지능 트레이드오프 조정용
# (1) 1단계 웹검색 — 기본 perplexity/sonar-pro (검색 특화)
IDEA_RESEARCH_MODEL=perplexity/sonar-pro
# (2) 3단계 30→10 narrowing — 지능 덜 필요. 미설정 시 OPENROUTER_MODEL(평소 모델)
IDEA_NARROW_MODEL=
# (3) 1.5단계 중요도 평가 + 5단계 최종 Top 5 — 지능 가장 필요.
#     미설정 시 OPENROUTER_MODEL. claude-sonnet-4.5/opus-4.7 권장
IDEA_SYNTHESIS_MODEL=

# =========== EarningsBot (미국 기업 어닝콜 + 비교 PDF) — 전용 봇 ===========
# 사용자 입력(회사 ticker 또는 자연어 조건) → 어닝콜 전문 grounding + SEC EDGAR 6년치
#   CapEx/OCF/FCF/Revenue → matplotlib 차트 6종 + 한국어 합성 → 텔레그램 + PDF 발송 (5-10분)
# 전용 텔레그램 봇 토큰 필요 (@BotFather 발급). 자유 텍스트 또는 /earnings 로 진입.
# 미국 상장사 전용 (SEC EDGAR 기반).
EARNINGS_BOT_TOKEN=
# 인가: 미설정 시 종목봇의 ALLOWED_CHAT_IDS 폴백. 전체 공개는 '*'.
EARNINGS_ALLOWED_CHAT_IDS=
# SEC EDGAR User-Agent (정책상 필수). 본인 이름 + 이메일.
SEC_EDGAR_USER_AGENT=earnings-call-bot your-email@example.com

# --- 진짜 전문(full transcript) 확보 — 품질의 핵심 ---
# 최소 1개 권장. 다 없으면 웹 스크레이프→perplexity 요약으로 graceful degrade
# (이 경우 환각 위험 ↑, 보고서에 "전문 비근거" 경고 표기).
#
# Alpha Vantage (★1순위·무료): https://www.alphavantage.co/support/#api-key 에서 즉시 무료 발급.
#   EARNINGS_CALL_TRANSCRIPT 엔드포인트가 무료 티어 포함 (25 req/day 제한 → 회당 4-6종목 OK).
#   year+quarter 명시 시 동작 (예: "2026 1Q"). 가장 권장.
ALPHA_VANTAGE_KEY=
# Financial Modeling Prep (유료): 무료 키는 transcript 엔드포인트 접근 불가(402/403). 유료 플랜만.
FMP_API_KEY=
# API Ninjas (유료): earningstranscript는 premium 구독 필요.
API_NINJAS_KEY=

# --- 모델 티어 (미설정 시 기본값) ---
# 종목별 전문 심층추출 — sonnet 기본 (IDEA_NARROW_MODEL 폴백)
EARNINGS_EXTRACT_MODEL=
# 최종 비교 합성 + 커스텀 분석 — opus 기본 (IDEA_SYNTHESIS_MODEL 폴백). 딥리서치급 추론.
EARNINGS_SYNTHESIS_MODEL=
# self-test (부팅 후 1회 자동 실행)
EARNINGS_TEST_PROMPT=

# 옵션: 카테고리별 dedup state 영구 보존 (Railway 볼륨 마운트 path)
# 미설정 시 컨테이너 재시작마다 state 손실 (일부 리포트 중복 발송 가능)
STATE_DIR=

# =========== ScreenerBot (한국 주식 기술적 신호 스크리너) ===========
# 자동: 매일 16:30 KST. 역사적/52주 신고가, VCP 돌파, 52주 돌파 직전.
# 코스피+코스닥 보통주 (ETF/SPAC/우선주/관리종목 제외). 데이터: pykrx (KRX 직접).
# 첫 실행 시 1년치 백필 자동 (~10분).
SCREENER_BOT_TOKEN=
SCREENER_CHAT_ID=
SCREENER_ALLOWED_CHAT_IDS=

# 신호 임계값 (선택)
SCREENER_NEAR_BREAKOUT_LOWER=0.95
SCREENER_NEAR_BREAKOUT_UPPER=0.99
SCREENER_PER_CATEGORY_TOP=30

# 자동 검증 (선택, CLAUDE.md 의무)
SCREENER_TEST_MODE=0      # 1로 두면 부팅 후 _self_test 1회 실행
SCREENER_FORCE_BACKFILL=0 # 1로 두면 다음 잡에서 강제 재백필

# =========== Deepdive 기능 (CompanyBot의 /deepdive 명령) ===========
# DART_API_KEY: https://opendart.fss.or.kr/ 회원가입 → 인증키 신청 → 발급
#   미설정 시 /deepdive 핸들러 자체가 등록되지 않음 (기존 봇은 정상)
# DEEPDIVE_ENABLED=0 → kill switch (발급된 키가 있어도 비활성화)
DART_API_KEY=
DEEPDIVE_ENABLED=1

# 동작 옵션
HEADLESS=true
DOWNLOAD_DIR=./downloads
SUMMARY_DIR=./summaries
SORT_BY=latest
TOP_N=10

# 프록시 환경에서 SSL 인증서 검증 무시 (corporate proxy / sandbox 등)
# 일반 환경에서는 false 유지 권장
IGNORE_HTTPS_ERRORS=false

# 로그인 세션 캐시 파일 (Playwright storage state)
STORAGE_STATE=./.wisereport_state.json
