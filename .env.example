# wisereport.co.kr 계정
WISEREPORT_ID=your_id_here
WISEREPORT_PW=your_password_here

# Anthropic API key (요약 기능용)
# https://console.anthropic.com/ 에서 발급
ANTHROPIC_API_KEY=sk-ant-...

# 동작 옵션
# headless 브라우저 사용 여부 (디버깅 시 false 권장)
HEADLESS=true

# 다운로드 폴더 루트 (기업명별 하위 폴더 자동 생성)
DOWNLOAD_DIR=./downloads

# 요약 결과 저장 폴더
SUMMARY_DIR=./summaries

# 정렬 기준: latest (최신순) | popular (조회순)
SORT_BY=latest

# 다운로드 개수
TOP_N=10
