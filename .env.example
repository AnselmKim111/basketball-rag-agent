# wisereport.co.kr 계정
WISEREPORT_ID=your_id_here
WISEREPORT_PW=your_password_here

# OpenRouter API key (요약용)
# https://openrouter.ai/keys 에서 발급
OPENROUTER_API_KEY=sk-or-v1-...
# 사용할 모델 (기본: anthropic/claude-sonnet-4.5)
# 다른 옵션: anthropic/claude-opus-4.7, openai/gpt-4o, google/gemini-2.5-pro 등
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# =========== CompanyBot (기업명+티커 → 종목 리포트 발송) ===========
# CLI(src.main) 발송 + bot_worker + orchestrator 모두에 사용
TELEGRAM_BOT_TOKEN=
TELEGRAM_USERNAME=@allymax
TELEGRAM_CHAT_ID=
ALLOWED_CHAT_IDS=

# =========== IndustryBot (산업 리포트, @AnselmsSlave3bot) ===========
# 자동: 월/수/금 09:00 KST → 산업 Top10 (1000자 요약 + PDF)
# 수동: 산업명 입력 → 인기 5건 + 최신 5건 (5000자 요약 + PDF)
INDUSTRY_BOT_TOKEN=
INDUSTRY_CHAT_ID=
INDUSTRY_ALLOWED_CHAT_IDS=

# =========== MarketBot (투자전략/시황, @AnselmsSlave4bot) ===========
# 자동: 매일 09:00 KST → 신규 시황 리포트 (1000자 요약 + PDF, 중복 제외)
MARKET_BOT_TOKEN=
MARKET_CHAT_ID=
MARKET_ALLOWED_CHAT_IDS=

# =========== GlobalBot (글로벌, 토큰 미정) ===========
# 자동: 매주 토 09:00 KST → 글로벌 Top10 (1000자 요약 + PDF)
GLOBAL_BOT_TOKEN=
GLOBAL_CHAT_ID=
GLOBAL_ALLOWED_CHAT_IDS=

# 옵션: 카테고리별 dedup state 영구 보존 (Railway 볼륨 마운트 path)
# 미설정 시 컨테이너 재시작마다 state 손실 (일부 리포트 중복 발송 가능)
STATE_DIR=

# 동작 옵션
HEADLESS=true
DOWNLOAD_DIR=./downloads
SUMMARY_DIR=./summaries
SORT_BY=latest
TOP_N=10

# 프록시 환경에서 SSL 인증서 검증 무시 (corporate proxy / sandbox 등)
# 일반 환경에서는 false 유지 권장
IGNORE_HTTPS_ERRORS=false

# 로그인 세션 캐시 파일 (Playwright storage state)
STORAGE_STATE=./.wisereport_state.json
